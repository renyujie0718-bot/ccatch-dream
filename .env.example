# ---------------------------------------------------------------------------
# 捕梦 2.0 环境变量模板
#
# 复制为 .env.local 后填写真实值（.env.local 已被 .gitignore 忽略）。
# 所有 AI 密钥只在服务端读取，绝不要加 NEXT_PUBLIC_ 前缀。
# ---------------------------------------------------------------------------

# --- DeepSeek（AI 写作伙伴 / 文学回声的语义整理） ---------------------------
# 在 https://platform.deepseek.com/ 申请。仅服务端使用。
DEEPSEEK_API_KEY=
# 模型名请以 DeepSeek 官方文档的当前可用模型为准，不要硬编码过时模型名：
# https://api-docs.deepseek.com/quick_start/pricing
# 常见取值示例（部署前请自行核实）：
#   deepseek-chat       通用对话模型
#   deepseek-reasoner   推理模型
DEEPSEEK_MODEL=deepseek-chat
# 单次请求超时（毫秒）
DEEPSEEK_TIMEOUT_MS=45000
# DeepSeek base URL，一般无需修改
DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- Supabase（登录 + 云端保存） -------------------------------------------
# 控制台 Project Settings -> API 中获取。
# 未配置这两项时，网站退化为「访客本地模式」，非 AI 功能依然完全可用。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 仅当需要执行管理员级服务端任务时才需要，务必只放在服务端。
SUPABASE_SERVICE_ROLE_KEY=

# --- 应用行为 --------------------------------------------------------------
# 允许分析的最大字符数（防止超长请求烧掉额度）
AI_MAX_INPUT_CHARS=6000
# 每个 IP 的 AI 请求限流：窗口内允许的次数与窗口长度（秒）
AI_RATE_LIMIT_MAX=12
AI_RATE_LIMIT_WINDOW_SECONDS=60
