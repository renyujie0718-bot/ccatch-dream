# 使用扁平（npm 风格）的 node_modules 布局。
#
# 原因：pnpm 默认的符号链接布局下，TypeScript 无法从
# node_modules/@supabase/supabase-js/dist/*.d.ts 里解析出 @supabase/auth-js 等
# 传递依赖，导致 client.auth.getSession() 这类调用全部报「属性不存在」。
# 这不是运行时问题，而是类型解析问题；换成 hoisted 布局可彻底避免。
node-linker=hoisted

# 依赖安装脚本白名单（esbuild 等需要），与 pnpm-workspace.yaml 保持一致
enable-pre-post-scripts=true
